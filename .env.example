# -------------------------------------------------------------
# Doctor Tracker Environment Variables
# -------------------------------------------------------------

# Next.js Port (Default 3000)
PORT=3000

# Base URL for the separate Express REST API server
# When running standalone demo / mock mode, this is optional.
# When your Express backend is running, set this to your backend endpoint:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Initial Mode: 'mock' (standalone localStorage seed) or 'real' (Express REST)
NEXT_PUBLIC_DEFAULT_API_MODE=mock

